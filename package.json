{
  "name": "mydms-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p apps/admin-web/tsconfig.json && tsc --noEmit -p apps/field-pwa/tsconfig.json",
    "build:admin": "vite build --config apps/admin-web/vite.config.ts",
    "build:pwa": "vite build --config apps/field-pwa/vite.config.ts",
    "build": "npm run typecheck && npm run build:admin && npm run build:pwa",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
